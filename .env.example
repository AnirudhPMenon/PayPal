# PayPal sandbox app (developer.paypal.com → Apps & Credentials → Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | mock (mock = offline, no PayPal calls; for tests only)
PAYPAL_MODE=sandbox
# Optional: webhook id from your app's Webhooks section (enables signature verification)
PAYPAL_WEBHOOK_ID=

# AI: set ONE of these (Gemini has a free key at aistudio.google.com)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional overrides
# AI_PROVIDER=gemini
# AI_MODEL=gemini-flash-lite-latest
# GEMINI_THINKING=low   (low | high | off)

# Your business
BUSINESS_NAME=Duely Studio
OWNER_NAME=
DEFAULT_CURRENCY=USD

# Public URL PayPal redirects back to (auto-detected on Render)
# PUBLIC_URL=http://localhost:3000
# PORT=3000

# Used by `npm run smoke` for a test payout (a sandbox personal account email)
RECIPIENT_EMAIL=
